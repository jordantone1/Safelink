// ── FORM VALIDATION & SUBMIT ──
(function() {
  const form = document.getElementById('intakeForm');
  const btn = document.getElementById('submitBtn');
  const success = document.getElementById('successMsg');
  let submitted = false;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitted) return;

    // Validate required fields
    const required = form.querySelectorAll('[required]');
    let valid = true;
    required.forEach(el => {
      el.classList.remove('error');
      if (!el.value.trim()) {
        el.classList.add('error');
        valid = false;
      }
    });
    if (!valid) {
      form.querySelector('.error')?.focus();
      return;
    }

    // Loading state
    submitted = true;
    btn.classList.add('loading');
    btn.disabled = true;

    // Simulate submission
    await new Promise(r => setTimeout(r, 1800));

    btn.style.display = 'none';
    success.classList.add('visible');
    success.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
})();

// ── LAYOUT BUILDER ──
(function() {
  const canvas = document.getElementById('layoutCanvas');
  const ctx = canvas.getContext('2d');
  const wrap = canvas.parentElement;
  const editor = document.getElementById('roomEditor');
  const nameInput = document.getElementById('roomNameInput');
  const sqftInput = document.getElementById('roomSqftInput');
  const saveBtn = document.getElementById('roomSaveBtn');
  const deleteBtn = document.getElementById('roomDeleteBtn');
  const hint = document.getElementById('layoutHint');
  const summary = document.getElementById('layoutSummary');
  const summaryText = document.getElementById('layoutSummaryText');
  const dataInput = document.getElementById('layoutDataInput');
  const clearBtn = document.getElementById('clearLayoutBtn');

  const DEVICE_LABELS = {
    computer:'Computer', pos:'POS/Register', wifi:'Wi-Fi AP',
    printer:'Printer', camera:'Camera', phone:'Desk Phone',
    tv:'TV/Display', server:'Network Rack'
  };
  const DEVICE_ICONS = {
    computer:'💻', pos:'🖥', wifi:'📡', printer:'🖨',
    camera:'📷', phone:'☎', tv:'📺', server:'🗄'
  };

  // Colors for rooms (cycling)
  const ROOM_COLORS = [
    'rgba(37,99,235,0.08)', 'rgba(16,185,129,0.08)',
    'rgba(245,158,11,0.08)', 'rgba(239,68,68,0.08)',
    'rgba(139,92,246,0.08)', 'rgba(14,165,233,0.08)',
  ];
  const ROOM_STROKES = [
    '#2563EB','#10B981','#F59E0B','#EF4444','#8B5CF6','#0EA5E9'
  ];

  let rooms = [];
  let devices = [];
  let tool = 'draw';
  let currentDevice = null;
  let drawing = false;
  let drawStart = null;
  let drawCurrent = null;
  let selectedRoomId = null;
  let editingRoomId = null;
  let colorIdx = 0;
  let scale = 1;
  const CANVAS_H = 380;
  const GRID = 20;

  function resize() {
    const w = wrap.clientWidth;
    canvas.width = w;
    canvas.height = CANVAS_H;
    scale = w / wrap.clientWidth;
    render();
  }
  window.addEventListener('resize', resize);
  resize();

  // ── Coordinate helpers ──
  function getPos(e) {
    const rect = canvas.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    return {
      x: snap((clientX - rect.left) * scaleX),
      y: snap((clientY - rect.top) * scaleY)
    };
  }
  function snap(v) { return Math.round(v / GRID) * GRID; }

  // ── Hit testing ──
  function roomAt(x, y) {
    for (let i = rooms.length - 1; i >= 0; i--) {
      const r = rooms[i];
      const rx = Math.min(r.x, r.x+r.w), ry = Math.min(r.y, r.y+r.h);
      const rw = Math.abs(r.w), rh = Math.abs(r.h);
      if (x >= rx && x <= rx+rw && y >= ry && y <= ry+rh) return r;
    }
    return null;
  }
  function deviceAt(x, y) {
    for (let i = devices.length-1; i>=0; i--) {
      const d = devices[i];
      if (Math.abs(d.x-x)<16 && Math.abs(d.y-y)<16) return d;
    }
    return null;
  }

  // ── Tool switching ──
  window.setTool = function(t) {
    tool = t;
    currentDevice = null;
    document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tool'+t.charAt(0).toUpperCase()+t.slice(1))?.classList.add('active');
    document.querySelectorAll('.dev-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('activeDeviceTag').style.display = 'none';
    canvas.style.cursor = t === 'draw' ? 'crosshair' : 'default';
    hideEditor();
  };

  window.setDevice = function(type) {
    currentDevice = type;
    tool = 'device';
    document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.dev-btn').forEach(b => b.classList.remove('active'));
    event.currentTarget.classList.add('active');
    const tag = document.getElementById('activeDeviceTag');
    tag.style.display = 'flex';
    tag.textContent = DEVICE_ICONS[type] + ' ' + DEVICE_LABELS[type] + ' — click canvas to place';
    canvas.style.cursor = 'cell';
    hideEditor();
  };

  // ── Editor ──
  function showEditor(room) {
    editingRoomId = room.id;
    nameInput.value = room.name || '';
    sqftInput.value = room.sqft || '';
    // Position editor near room
    const rect = canvas.getBoundingClientRect();
    const scaleX = rect.width / canvas.width;
    const scaleY = rect.height / canvas.height;
    const rx = Math.min(room.x, room.x+room.w);
    const ry = Math.min(room.y, room.y+room.h);
    let ex = rx * scaleX;
    let ey = (ry + Math.abs(room.h)) * scaleY + 6;
    if (ey + 60 > rect.height) ey = ry * scaleY - 60;
    editor.style.left = Math.min(ex, rect.width - 300) + 'px';
    editor.style.top = ey + 'px';
    editor.style.display = 'flex';
    nameInput.focus();
  }
  function hideEditor() {
    editor.style.display = 'none';
    editingRoomId = null;
  }

  saveBtn.onclick = () => {
    const r = rooms.find(r => r.id === editingRoomId);
    if (r) {
      r.name = nameInput.value || 'Room';
      r.sqft = parseInt(sqftInput.value) || 0;
    }
    hideEditor();
    render();
    updateSummary();
  };
  nameInput.addEventListener('keydown', e => { if (e.key === 'Enter') saveBtn.click(); });
  sqftInput.addEventListener('keydown', e => { if (e.key === 'Enter') saveBtn.click(); });

  deleteBtn.onclick = () => {
    rooms = rooms.filter(r => r.id !== editingRoomId);
    devices = devices.filter(d => d.roomId !== editingRoomId);
    hideEditor();
    render();
    updateSummary();
  };

  // ── Mouse events ──
  function onDown(e) {
    e.preventDefault();
    const pos = getPos(e);
    if (tool === 'draw') {
      const existing = roomAt(pos.x, pos.y);
      if (existing) {
        // Click on existing room in draw mode — select it
        selectedRoomId = existing.id;
        showEditor(existing);
        render();
        return;
      }
      drawing = true;
      drawStart = pos;
      drawCurrent = pos;
      hideEditor();
    } else if (tool === 'select') {
      const r = roomAt(pos.x, pos.y);
      if (r) { selectedRoomId = r.id; showEditor(r); }
      else { selectedRoomId = null; hideEditor(); }
      render();
    } else if (tool === 'device') {
      // Check if clicking existing device (to remove)
      const existing = deviceAt(pos.x, pos.y);
      if (existing && existing.type === currentDevice) {
        devices = devices.filter(d => d !== existing);
        render(); updateSummary(); return;
      }
      const room = roomAt(pos.x, pos.y);
      devices.push({ id: Date.now(), type: currentDevice, x: pos.x, y: pos.y, roomId: room ? room.id : null });
      render(); updateSummary();
    }
  }

  function onMove(e) {
    e.preventDefault();
    if (!drawing) return;
    drawCurrent = getPos(e);
    render();
  }

  function onUp(e) {
    e.preventDefault();
    if (!drawing) return;
    drawing = false;
    const w = drawCurrent.x - drawStart.x;
    const h = drawCurrent.y - drawStart.y;
    if (Math.abs(w) > GRID && Math.abs(h) > GRID) {
      const room = {
        id: Date.now(),
        x: drawStart.x, y: drawStart.y, w, h,
        name: '', sqft: 0,
        colorIdx: colorIdx % ROOM_COLORS.length
      };
      colorIdx++;
      rooms.push(room);
      selectedRoomId = room.id;
      render();
      showEditor(room);
      hint.textContent = 'Click a room to label it · Select a device icon then click to place it';
      updateSummary();
    }
    drawStart = null; drawCurrent = null;
  }

  canvas.addEventListener('mousedown', onDown);
  canvas.addEventListener('mousemove', onMove);
  canvas.addEventListener('mouseup', onUp);
  canvas.addEventListener('touchstart', onDown, {passive:false});
  canvas.addEventListener('touchmove', onMove, {passive:false});
  canvas.addEventListener('touchend', onUp, {passive:false});

  clearBtn.onclick = () => {
    if (rooms.length === 0 && devices.length === 0) return;
    rooms = []; devices = []; colorIdx = 0;
    hideEditor(); render(); updateSummary();
    hint.textContent = 'Click and drag on the canvas to draw your first room';
  };

  // ── Render ──
  function render() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drawGrid();
    rooms.forEach(r => drawRoom(r));
    if (drawing && drawStart && drawCurrent) drawGhost();
    devices.forEach(d => drawDevice(d));
  }

  function drawGrid() {
    ctx.strokeStyle = 'rgba(203,213,225,0.5)';
    ctx.lineWidth = 0.5;
    for (let x = 0; x <= canvas.width; x += GRID) {
      ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x, canvas.height); ctx.stroke();
    }
    for (let y = 0; y <= canvas.height; y += GRID) {
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(canvas.width,y); ctx.stroke();
    }
    // Major grid lines every 5
    ctx.strokeStyle = 'rgba(203,213,225,0.9)';
    for (let x = 0; x <= canvas.width; x += GRID*5) {
      ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x, canvas.height); ctx.stroke();
    }
    for (let y = 0; y <= canvas.height; y += GRID*5) {
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(canvas.width,y); ctx.stroke();
    }
  }

  function drawRoom(r) {
    const rx = Math.min(r.x, r.x+r.w), ry = Math.min(r.y, r.y+r.h);
    const rw = Math.abs(r.w), rh = Math.abs(r.h);
    const isSelected = r.id === selectedRoomId;

    ctx.fillStyle = ROOM_COLORS[r.colorIdx];
    ctx.fillRect(rx, ry, rw, rh);

    ctx.strokeStyle = ROOM_STROKES[r.colorIdx];
    ctx.lineWidth = isSelected ? 2.5 : 1.5;
    ctx.setLineDash(isSelected ? [] : []);
    ctx.strokeRect(rx, ry, rw, rh);

    // Corner accent
    const cs = 12;
    ctx.strokeStyle = ROOM_STROKES[r.colorIdx];
    ctx.lineWidth = 2;
    ['tl','tr','bl','br'].forEach(corner => {
      const cx = corner.includes('l') ? rx : rx+rw;
      const cy = corner.includes('t') ? ry : ry+rh;
      const dx = corner.includes('l') ? 1 : -1;
      const dy = corner.includes('t') ? 1 : -1;
      ctx.beginPath();
      ctx.moveTo(cx + dx*cs, cy);
      ctx.lineTo(cx, cy);
      ctx.lineTo(cx, cy + dy*cs);
      ctx.stroke();
    });

    // Label
    if (r.name) {
      ctx.fillStyle = ROOM_STROKES[r.colorIdx];
      ctx.font = `bold 12px 'IBM Plex Sans', sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(r.name, rx + rw/2, ry + rh/2 - (r.sqft ? 8 : 0));
      if (r.sqft) {
        ctx.fillStyle = 'rgba(100,116,139,0.9)';
        ctx.font = `11px 'IBM Plex Mono', monospace`;
        ctx.fillText('~' + r.sqft + ' sq ft', rx + rw/2, ry + rh/2 + 10);
      }
    } else {
      ctx.fillStyle = 'rgba(100,116,139,0.5)';
      ctx.font = `11px 'IBM Plex Sans', sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('click to label', rx + rw/2, ry + rh/2);
    }

    // Dimension hints on edges
    ctx.fillStyle = 'rgba(100,116,139,0.5)';
    ctx.font = `9px 'IBM Plex Mono', monospace`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    const cells = Math.round(rw / GRID) + '×' + Math.round(rh / GRID);
    ctx.fillText(cells, rx + rw - 18, ry + 9);
  }

  function drawGhost() {
    const rx = Math.min(drawStart.x, drawCurrent.x);
    const ry = Math.min(drawStart.y, drawCurrent.y);
    const rw = Math.abs(drawCurrent.x - drawStart.x);
    const rh = Math.abs(drawCurrent.y - drawStart.y);
    ctx.fillStyle = 'rgba(37,99,235,0.05)';
    ctx.fillRect(rx, ry, rw, rh);
    ctx.strokeStyle = 'rgba(37,99,235,0.5)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([6, 3]);
    ctx.strokeRect(rx, ry, rw, rh);
    ctx.setLineDash([]);
  }

  function drawDevice(d) {
    // Shadow
    ctx.shadowColor = 'rgba(0,0,0,0.1)';
    ctx.shadowBlur = 4;
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.arc(d.x, d.y, 13, 0, Math.PI*2);
    ctx.fill();
    ctx.shadowBlur = 0;

    ctx.strokeStyle = '#2563EB';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(d.x, d.y, 13, 0, Math.PI*2);
    ctx.stroke();

    ctx.font = '13px serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(DEVICE_ICONS[d.type], d.x, d.y + 1);

    // Tooltip label below
    ctx.fillStyle = 'rgba(37,99,235,0.8)';
    ctx.font = '8px IBM Plex Mono, monospace';
    ctx.fillText(DEVICE_LABELS[d.type].split('/')[0].trim().toUpperCase(), d.x, d.y + 22);
  }

  // ── Summary ──
  function updateSummary() {
    if (rooms.length === 0 && devices.length === 0) {
      summary.style.display = 'none';
      dataInput.value = '';
      return;
    }
    summary.style.display = 'block';
    let html = '';
    let textParts = [];
    rooms.forEach(r => {
      const roomDevices = devices.filter(d => d.roomId === r.id);
      const name = r.name || 'Unnamed Room';
      const sqft = r.sqft ? `~${r.sqft} sq ft` : '';
      const devList = roomDevices.map(d => DEVICE_LABELS[d.type]).join(', ');
      html += `<div class="summary-room">
        <strong>${name}</strong>${sqft ? ` <span>(${sqft})</span>` : ''}
        ${devList ? `<br><span>Devices: ${devList}</span>` : ''}
      </div>`;
      textParts.push(`${name}${sqft ? ' (' + sqft + ')' : ''}${devList ? ': ' + devList : ''}`);
    });
    const unplaced = devices.filter(d => !d.roomId);
    if (unplaced.length) {
      const ul = unplaced.map(d => DEVICE_LABELS[d.type]).join(', ');
      html += `<div class="summary-room"><span>Unplaced devices: ${ul}</span></div>`;
      textParts.push(`Other devices (unplaced): ${ul}`);
    }
    summaryText.innerHTML = html;
    dataInput.value = JSON.stringify({ rooms: rooms.map(r => ({
      name: r.name, sqft: r.sqft,
      devices: devices.filter(d => d.roomId===r.id).map(d => d.type)
    }))});
  }

  // Initial render
  render();
})();

</script>

</body>
</html>
