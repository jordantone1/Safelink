(function() {
  const canvas = document.getElementById('services-canvas');
  const ctx = canvas.getContext('2d');
  const headline = document.getElementById('servicesHeadline');

  function resize() {
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
  }
  window.addEventListener('resize', () => { resize(); });
  resize();

  const services = [
    { label: 'Network Infrastructure', sub: 'Cabling, switches, firewalls', angle: -Math.PI/4 },
    { label: 'Wi-Fi & Connectivity', sub: 'Access points, optimization', angle: Math.PI/4 },
    { label: 'Microsoft Teams Voice', sub: 'Calling, phones, porting', angle: Math.PI + Math.PI/4 },
    { label: 'Ongoing Support', sub: 'Maintenance, updates', angle: Math.PI - Math.PI/4 },
  ];

  let progress = 0; // 0 to 1

  function getServicePos(i, p, cx, cy) {
    const targetR = Math.min(canvas.width, canvas.height) * 0.3;
    const angle = services[i].angle;
    const eased = easeInOut(Math.min(p * 2, 1));
    return {
      x: cx + Math.cos(angle) * targetR * eased,
      y: cy + Math.sin(angle) * targetR * eased,
    };
  }

  function easeInOut(t) {
    return t < 0.5 ? 2*t*t : -1+(4-2*t)*t;
  }

  // Satellite nodes
  const satNodes = [];
  for (let s = 0; s < 4; s++) {
    for (let k = 0; k < 5; k++) {
      satNodes.push({
        service: s,
        offsetAngle: (Math.PI * 2 / 5) * k,
        r2: 40 + Math.random() * 20,
        r: 2 + Math.random(),
        alpha: 0.3 + Math.random() * 0.4
      });
    }
  }

  function draw(p) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const cx = canvas.width / 2, cy = canvas.height / 2;

    // Center node
    const centerAlpha = 1 - easeInOut(Math.min(p * 3, 1)) * 0.5;
    ctx.beginPath();
    ctx.arc(cx, cy, 8, 0, Math.PI*2);
    ctx.fillStyle = `rgba(37,99,235,${centerAlpha})`;
    ctx.fill();
    ctx.beginPath();
    ctx.arc(cx, cy, 16, 0, Math.PI*2);
    ctx.strokeStyle = `rgba(37,99,235,${centerAlpha * 0.3})`;
    ctx.lineWidth = 1;
    ctx.stroke();

    // Service nodes
    services.forEach((svc, i) => {
      const pos = getServicePos(i, p, cx, cy);
      const alpha = Math.min(p * 3, 1);

      // Line from center
      if (alpha > 0) {
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(pos.x, pos.y);
        ctx.strokeStyle = `rgba(37,99,235,${alpha * 0.4})`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      // Satellite nodes
      satNodes.filter(sn => sn.service === i).forEach(sn => {
        if (p < 0.5) return;
        const sp = easeInOut((p - 0.5) * 2);
        const sx = pos.x + Math.cos(sn.offsetAngle) * sn.r2 * sp;
        const sy = pos.y + Math.sin(sn.offsetAngle) * sn.r2 * sp;
        ctx.beginPath();
        ctx.arc(sx, sy, sn.r, 0, Math.PI*2);
        ctx.fillStyle = `rgba(37,99,235,${sn.alpha * sp})`;
        ctx.fill();
        // line to cluster center
        ctx.beginPath();
        ctx.moveTo(pos.x, pos.y);
        ctx.lineTo(sx, sy);
        ctx.strokeStyle = `rgba(37,99,235,${0.15 * sp})`;
        ctx.lineWidth = 0.5;
        ctx.stroke();
      });

      // Service node circle
      ctx.beginPath();
      ctx.arc(pos.x, pos.y, 6, 0, Math.PI*2);
      ctx.fillStyle = `rgba(37,99,235,${alpha})`;
      ctx.fill();
      ctx.beginPath();
      ctx.arc(pos.x, pos.y, 12, 0, Math.PI*2);
      ctx.strokeStyle = `rgba(37,99,235,${alpha * 0.25})`;
      ctx.lineWidth = 1;
      ctx.stroke();

      // Label
      if (alpha > 0.4) {
        const labelAlpha = Math.min((alpha - 0.4) / 0.6, 1);
        const angle = services[i].angle;
        const lx = pos.x + Math.cos(angle) * 36;
        const ly = pos.y + Math.sin(angle) * 28;

        ctx.fillStyle = `rgba(255,255,255,${labelAlpha})`;
        ctx.font = `bold 13px 'IBM Plex Sans', sans-serif`;
        ctx.textAlign = Math.cos(angle) > 0.1 ? 'left' : Math.cos(angle) < -0.1 ? 'right' : 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(svc.label, lx, ly - 7);

        ctx.fillStyle = `rgba(100,116,139,${labelAlpha})`;
        ctx.font = `11px 'IBM Plex Sans', sans-serif`;
        ctx.fillText(svc.sub, lx, ly + 8);
      }
    });
  }

  // Scroll driver
  const section = document.getElementById('services');
  function onScroll() {
    const rect = section.getBoundingClientRect();
    const trackH = section.scrollHeight - window.innerHeight;
    const scrolled = -rect.top;
    progress = Math.max(0, Math.min(1, scrolled / trackH));
    draw(progress);
    if (progress > 0.3) {
      headline.classList.add('visible');
    } else {
      headline.classList.remove('visible');
    }
  }
  window.addEventListener('scroll', onScroll, {passive: true});
  draw(0);
  headline.classList.remove('visible');
})();

// ── BLUEPRINT CANVAS (SCROLL-DRIVEN) ──
(function() {
  const canvas = document.getElementById('blueprint-canvas');
  const ctx = canvas.getContext('2d');

  function resize() {
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
  }
  window.addEventListener('resize', resize);
  resize();

  const deviceLabels = [
    { id:'internet', label:'Internet', icon:'⬆', col:2, row:0 },
    { id:'firewall', label:'Firewall', icon:'🛡', col:2, row:1 },
    { id:'wifi', label:'Wi-Fi AP', icon:'📡', col:0, row:2 },
    { id:'pos', label:'POS', icon:'🖥', col:1, row:2 },
    { id:'printers', label:'Printers', icon:'🖨', col:2, row:2 },
    { id:'computers', label:'Computers', icon:'💻', col:3, row:2 },
    { id:'phones', label:'Phones', icon:'📞', col:4, row:2 },
  ];

  const connections = [
    ['internet','firewall'],
    ['firewall','wifi'],
    ['firewall','pos'],
    ['firewall','printers'],
    ['firewall','computers'],
    ['firewall','phones'],
  ];

  let progress = 0;

  function getPos(device, p) {
    const cx = canvas.width/2, cy = canvas.height/2 - 40;
    const colW = Math.min(canvas.width * 0.18, 140);
    const rowH = Math.min(canvas.height * 0.22, 160);
    const cols = 5;
    const targetX = (device.col - (cols-1)/2) * colW + cx;
    const targetY = (device.row - 1) * rowH + cy;
    // Start at center
    const eased = easeInOut(Math.min(p * 1.5, 1));
    return {
      x: cx + (targetX - cx) * eased,
      y: cy + (targetY - cy) * eased,
    };
  }

  function easeInOut(t) { return t < 0.5 ? 2*t*t : -1+(4-2*t)*t; }

  function getDeviceById(id) {
    return deviceLabels.find(d => d.id === id);
  }

  function drawBlueprintGrid(alpha) {
    ctx.strokeStyle = `rgba(37,99,235,${alpha * 0.07})`;
    ctx.lineWidth = 0.5;
    const step = 48;
    for (let x = 0; x < canvas.width; x += step) {
      ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,canvas.height); ctx.stroke();
    }
    for (let y = 0; y < canvas.height; y += step) {
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(canvas.width,y); ctx.stroke();
    }
  }

  function draw(p) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drawBlueprintGrid(p);

    const positions = {};
    deviceLabels.forEach(d => {
      positions[d.id] = getPos(d, p);
    });

    // Draw connections
    const connAlpha = easeInOut(Math.min(p, 1));
    connections.forEach(([a, b]) => {
      const pa = positions[a], pb = positions[b];
      if (!pa || !pb) return;
      ctx.beginPath();
      ctx.moveTo(pa.x, pa.y);
      ctx.lineTo(pb.x, pb.y);
      ctx.strokeStyle = `rgba(37,99,235,${connAlpha * 0.6})`;
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);
    });

    // Draw nodes
    deviceLabels.forEach(d => {
      const pos = positions[d.id];
      const nodeAlpha = easeInOut(Math.min(p * 1.2, 1));

      // Node circle
      ctx.beginPath();
      ctx.arc(pos.x, pos.y, 24, 0, Math.PI*2);
      ctx.fillStyle = `rgba(10,37,64,${nodeAlpha * 0.9})`;
      ctx.fill();
      ctx.beginPath();
      ctx.arc(pos.x, pos.y, 24, 0, Math.PI*2);
      ctx.strokeStyle = `rgba(37,99,235,${nodeAlpha * 0.8})`;
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Label
      ctx.fillStyle = `rgba(255,255,255,${nodeAlpha})`;
      ctx.font = `600 11px 'IBM Plex Sans'`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(d.label, pos.x, pos.y + 2);

      // Label below
      if (p > 0.5) {
        const la = easeInOut((p - 0.5) * 2);
        ctx.fillStyle = `rgba(37,99,235,${la * 0.8})`;
        ctx.font = `500 10px 'IBM Plex Mono'`;
        ctx.fillText(d.label === 'Internet' ? 'WAN' : d.id.toUpperCase(), pos.x, pos.y + 38);
      }
    });
  }

  const section = document.getElementById('blueprint');
  function onScroll() {
    const rect = section.getBoundingClientRect();
    const trackH = section.scrollHeight - window.innerHeight;
    const scrolled = -rect.top;
    progress = Math.max(0, Math.min(1, scrolled / trackH));
    draw(progress);
  }
  window.addEventListener('scroll', onScroll, {passive: true});
  draw(0);
})();

